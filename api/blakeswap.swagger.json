          }
        }
      }
    },
    "v1HTLC": {
      "type": "object",
      "properties": {
        "chain": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "claim_key": {
          "type": "string"
        },
        "refund_key": {
          "type": "string"
        },
        "refund_locktime": {
          "type": "integer",
          "format": "int64",
          "description": "Legacy JSON alias; block height on regtest, median-time Unix timestamp on public networks."
        },
        "amount": {
          "type": "string",
          "format": "int64"
        },
        "txid": {
          "type": "string"
        },
        "vout": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1MineRequest": {
      "type": "object",
      "properties": {
        "chain": {
          "type": "string"
        },
        "blocks": {
          "type": "integer",
          "format": "int64"
