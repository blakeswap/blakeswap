          }
        },
        "network": {
          "type": "string"
        },
        "own_watchtower": {
          "$ref": "#/definitions/v1Tower"
        },
        "watchtowers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Tower"
          }
        },
        "funding_fee": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "googleRpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "v1Backup": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "v1CheckNodeRequest": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string"
        },
        "chain": {
          "type": "string"
        },
        "node": {
          "$ref": "#/definitions/v1Node"
        }
      }
    },
    "v1CheckNodeResponse": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "int64"
        },
        "trust": {
          "type": "string"
        }
      }
    },
    "v1ConfirmFirstWalletRequest": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "format": "uint64"
        },
        "words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "v1CreateOfferRequest": {
      "type": "object",
      "properties": {
        "tower_pubkey": {
          "type": "string",
          "description": "Selected discovered provider; ignored when protection is off."
        },
        "sell": {
          "type": "string",
          "description": "btc or blake."
        },
        "expected_network": {
          "type": "string",
          "description": "Must match the active desktop network."
        },
        "sell_amount": {
          "type": "string",
          "format": "int64"
        },
        "buy_amount": {
          "type": "string",
          "format": "int64"
        },
        "tower_bps": {
          "type": "string",
          "format": "int64"
        },
        "expires": {
          "type": "string",
          "format": "int64",
          "description": "Unix seconds; zero means 24 hours."
        }
      }
    },
    "v1CreateWalletRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "v1Environment": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "description": "regtest, testnet (Testnet4), or mainnet."
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/v1Node"
          },
          "description": "Exactly btc and blake."
        },
        "relays": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tower": {
          "$ref": "#/definitions/v1Tower"
        },
        "public_watchtower": {
          "type": "boolean",
          "description": "Off by default; private npub lookup remains available."
        },
        "favorite_watchtowers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Provider npubs, scoped to this network."
        },
        "rescue_fee_bps": {
          "type": "string",
          "format": "int64",
          "description": "Own wallets' rescue rate: 1–1000 basis points; 0 retains the 50 bps default."
        }
      }
    },
    "v1ExportFirstWalletRequest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "v1FaucetRequest": {
      "type": "object",
      "properties": {
        "chain": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "format": "int64"
        },
        "expected_network": {
